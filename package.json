{
  "name": "offline-v70",
  "version": "0.1.0",
  "private": true,
  "description": "In-process offline server for Brawl Stars v70 iOS ARM64, following NBS Offline architecture",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "node esbuild.config.js",
    "check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.cjs\" esbuild.config.js package.json tsconfig.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.cjs\" esbuild.config.js package.json tsconfig.json",
    "test": "node --test tests/*.test.cjs",
    "start": "python3 scripts/run.py"
  },
  "devDependencies": {
    "@types/frida-gum": "19.0.0",
    "esbuild": "0.27.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3"
  }
}
